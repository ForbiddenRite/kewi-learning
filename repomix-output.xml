        document.addEventListener("DOMContentLoaded", () => {
            if (!requireAuth(ROLE_TEACHER)) return;
            const user = getCurrentUser();

            // Populate selects
            Object.entries(SUBJECTS).forEach(([k,v]) => {
                document.getElementById("subject").innerHTML += `<option value="${k}">${v}</option>`;
            });

            Object.entries(EXERCISE_TYPES).forEach(([k,v]) => {
                document.getElementById("type").innerHTML += `<option value="${k}">${v}</option>`;
            });

            Object.entries(DIFFICULTIES).forEach(([k,v]) => {
                document.getElementById("difficulty").innerHTML += `<option value="${k}">${v}</option>`;
            });

            document.getElementById("type").addEventListener("change", (e) => {
                document.getElementById("passage-group").style.display =
                    e.target.value === EXERCISE_TYPE_READING ? "block" : "none";
            });

            function addQuestion() {
                questionCount++;
                const id = "q_" + questionCount;
                const html = `
                    <div class="card mb-md" id="question-block-${questionCount}" data-qid="${id}">
                        <div class="card-body">
                            <div class="flex-between mb-md">
                                <h4>Question ${questionCount}</h4>
                                <button type="button" class="btn btn-sm btn-danger" onclick="this.closest('.card').remove()">Remove</button>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Question Text *</label>
                                <input type="text" class="form-control q-text" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Type</label>
                                <select class="form-control q-type">
                                    <option value="multiple_choice">Multiple Choice</option>
                                    <option value="true_false">True / False</option>
                                    <option value="fill_blank">Fill in the Blank</option>
                                </select>
                            </div>
                            <div class="q-options-area">
                                <div class="form-group">
                                    <label class="form-label">Options (one per line, for MCQ)</label>
                                    <textarea class="form-control q-options" rows="3" placeholder="Option A&#10;Option B&#10;Option C&#10;Option D"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Correct Answer *</label>
                                <input type="text" class="form-control q-answer" required placeholder="Exact correct answer">
                            </div>
                        </div>
                    </div>
                `;
                document.getElementById("questions-container").insertAdjacentHTML("beforeend", html);
            }

            document.getElementById("add-question-btn").addEventListener("click", addQuestion);
            addQuestion(); // start with one

            document.getElementById("create-form").addEventListener("submit", (e) => {
                e.preventDefault();
                const blocks = document.querySelectorAll("[id^='question-block-']");
                if (blocks.length === 0) {
                    showToast("Add at least one question.", "error");
                    return;
                }
                const questions = [];
                blocks.forEach((block, i) => {
                    const text = block.querySelector(".q-text").value.trim();
                    const type = block.querySelector(".q-type").value;
                    const answer = block.querySelector(".q-answer").value.trim();
                    const optionsRaw = block.querySelector(".q-options").value.trim();
                    const q = {
                        id: "q" + (i + 1),
                        text,
                        type,
                        correctAnswer: answer
                    };
                    if (type === "multiple_choice" && optionsRaw) {
                        q.options = optionsRaw.split("\n").map(o => o.trim()).filter(Boolean);
                    }
                    if (type === "true_false") {
                        q.options = ["true", "false"];
                    }
                    questions.push(q);
                });

                const data = {
                    title: document.getElementById("title").value.trim(),
                    description: document.getElementById("description").value.trim(),
                    type: document.getElementById("type").value,
                    subject: document.getElementById("subject").value,
                    difficulty: document.getElementById("difficulty").value,
                    pointsPerQuestion: parseInt(document.getElementById("points").value) || DEFAULT_POINTS_PER_QUESTION,
                    passage: document.getElementById("passage").value.trim() || null,
                    questions,
                    createdBy: user.id
                };

                try {
                    createExercise(data);
                    showToast("Exercise created successfully!", "success");
                    setTimeout(() => window.location.href = "exercises.html", 800);
                } catch (err) {
                    showToast(err.message || "Failed to create exercise.", "error");
                }
            });
        });
    </script>
</body>
</html>
