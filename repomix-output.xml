                        <table class="table">
                            <thead>
                                <tr><th>Rank</th><th>Student</th><th>Avg Score</th><th>Completed</th><th>Total Points</th></tr>
                            </thead>
                            <tbody id="overall-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h3>By Exercise</h3></div>
                <div class="card-body">
                    <div class="form-group">
                        <label class="form-label">Select Exercise</label>
                        <select id="ex-select" class="form-control" style="max-width:400px;"></select>
                    </div>
                    <div class="table-wrapper mt-md">
                        <table class="table">
                            <thead>
                                <tr><th>Rank</th><th>Student</th><th>Score</th><th>%</th><th>Submitted</th></tr>
                            </thead>
                            <tbody id="ex-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>
