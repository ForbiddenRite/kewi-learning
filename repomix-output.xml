                <div class="table-wrapper">
                    <table class="table">
                        <thead><tr><th>Student</th><th>Score</th><th>%</th><th>Submitted</th></tr></thead>
                        <tbody>${resultsHtml}</tbody>
                    </table>
                </div>
            `;
        });
    </script>
