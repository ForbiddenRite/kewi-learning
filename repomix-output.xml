                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="../../js/constants.js"></script>
    <script src="../../data/users.js"></script>
    <script src="../../data/exercises.js"></script>
    <script src="../../data/results.js"></script>
    <script src="../../js/auth.js"></script>
    <script src="../../js/utils.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (!requireAuth(ROLE_TEACHER)) return;

            const exercises = getActiveExercises();
            const students = getStudents();
            const totalStudents = students.length;

            const byExBody = document.getElementById("by-exercise-body");
            byExBody.innerHTML = exercises.map(ex => {
                const results = getResultsByExercise(ex.id);
                const avg = results.length
                    ? Math.round(results.reduce((s, r) => s + r.percentage, 0) / results.length)
                    : 0;
                const completion = totalStudents > 0 ? Math.round((results.length / totalStudents) * 100) : 0;
                return `
                    <tr>
                        <td class="fw-semibold">${escapeHtml(ex.title)}</td>
                        <td>${getSubjectBadge(ex.subject)}</td>
                        <td>${results.length}</td>
                        <td>${results.length ? getScoreBadge(avg) : "—"}</td>
                        <td>
                            <div class="flex-center gap-sm">
                                <div class="progress" style="width:80px;"><div class="progress-bar" style="width:${completion}%"></div></div>
                                <span class="text-sm">${completion}%</span>
                            </div>
                        </td>
                    </tr>
                `;
            }).join("") || '<tr><td colspan="5" class="text-center text-muted">No exercises.</td></tr>';

            const results = getResults().slice().sort((a,b) => new Date(b.submittedAt) - new Date(a.submittedAt));
            const allBody = document.getElementById("all-results-body");
            allBody.innerHTML = results.map(r => {
                const student = findUserById(r.studentId);
                const exercise = findExerciseById(r.exerciseId);
                return `
                    <tr>
                        <td>${escapeHtml(student ? student.fullName : "Unknown")}</td>
                        <td>${escapeHtml(exercise ? exercise.title : "—")}</td>
                        <td>${r.score} / ${r.maxScore}</td>
                        <td>${getScoreBadge(r.percentage)}</td>
                        <td>${formatDateTime(r.submittedAt)}</td>
                    </tr>
                `;
            }).join("") || '<tr><td colspan="5" class="text-center text-muted">No submissions yet.</td></tr>';
        });
    </script>
</body>
</html>
