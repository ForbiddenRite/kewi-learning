                const subSelect = document.getElementById("filter-subject");
                Object.entries(SUBJECTS).forEach(([k, v]) => {
                    subSelect.innerHTML += `<option value="${k}">${v}</option>`;
                });
                const typeSelect = document.getElementById("filter-type");
                Object.entries(EXERCISE_TYPES).forEach(([k, v]) => {
                    typeSelect.innerHTML += `<option value="${k}">${v}</option>`;
                });
                const diffSelect = document.getElementById("filter-difficulty");
                Object.entries(DIFFICULTIES).forEach(([k, v]) => {
                    diffSelect.innerHTML += `<option value="${k}">${v}</option>`;
                });

                function render() {
                    const search = document
                        .getElementById("search-input")
                        .value.toLowerCase();
                    const subject =
                        document.getElementById("filter-subject").value;
                    const type = document.getElementById("filter-type").value;
                    const difficulty =
                        document.getElementById("filter-difficulty").value;
                    const status =
                        document.getElementById("filter-status").value;

                    // Teachers see all exercises (enabled + disabled); students only see active via getActiveExercises()
                    let list = getExercises();
                    if (search)
                        list = list.filter((e) =>
                            e.title.toLowerCase().includes(search),
                        );
                    if (subject)
                        list = list.filter((e) => e.subject === subject);
                    if (type) list = list.filter((e) => e.type === type);
                    if (difficulty)
                        list = list.filter((e) => e.difficulty === difficulty);
                    if (status) list = list.filter((e) => e.status === status);

                    const container = document.getElementById("exercises-list");
                    if (list.length === 0) {
                        container.innerHTML =
                            '<div class="empty-state" style="grid-column:1/-1;"><div class="empty-state-icon">📝</div><p>No exercises found.</p></div>';
                        return;
                    }
                    container.innerHTML = list
                        .map((ex) => {
                            const results = getResultsByExercise(ex.id);
                            const maxScore = getExerciseMaxScore(ex);
                            const isActive = ex.status === STATUS_ACTIVE;
                            const toggleBtn = isActive
                                ? `<div class="btn-toggle-enabled" onclick="handleToggleEnabled('${ex.id}', false)" title="Hide from students (e.g. in-class test)"><i class="fa-solid fa-toggle-on"></i></div>`
                                : `<div class="btn-toggle-disabled" onclick="handleToggleEnabled('${ex.id}', true)" title="Make available to students"><i class="fa-solid fa-toggle-off"></i></div>`;
                            return `
                        <div class="exercise-card" style="${isActive ? "" : "filter: brightness(60%);"}">
                            <div class="exercise-card-header">
                                <span class="exercise-header-left">${getTypeBadge(ex.type)}</span>
                                <span class="exercise-header-right">
                                    ${getDifficultyBadge(ex.difficulty)}
                                    ${toggleBtn}
                                </span>
                            </div>
                            <div class="exercise-card-body">
                                <h3 class="card-title">${escapeHtml(ex.title)}</h3>
                                <p class="text-muted text-sm">${escapeHtml(truncate(ex.description, 80))}</p>
                                <div class="exercise-meta">
                                    ${getSubjectBadge(ex.subject)}
                                    <span class="badge badge-info">${(ex.questions || []).length} Qs</span>
                                    <span class="badge badge-primary">${maxScore} pts</span>
                                </div>
                            </div>
                            <div class="exercise-card-footer">
                                <span class="text-sm text-muted">${results.length} submission(s)</span>
                                <div class="flex gap-sm flex-wrap">
                                    <a href="exercise-detail.html?id=${ex.id}" class="btn btn-sm btn-outline">View</a>
                                    <button class="btn btn-sm btn-danger" onclick="handleDelete('${ex.id}')" title="Permanently remove this exercise">Delete</button>
                                </div>
                            </div>
                        </div>
                    `;
                        })
                        .join("");
                }

                window.handleToggleEnabled = function (id, enabled) {
                    const msg = enabled
                        ? "Enable this exercise? Students will be able to see and attempt it."
                        : "Disable this exercise? Students will no longer see or attempt it (e.g. for an in-class test).";
                    if (!confirmAction(msg)) return;
                    setExerciseEnabled(id, enabled);
                    showToast(
                        enabled
                            ? "Exercise enabled for students."
                            : "Exercise disabled for students.",
                        "success",
                    );
                    render();
                };

                window.handleDelete = function (id) {
                    if (
                        !confirmAction(
                            "Permanently delete this exercise? This cannot be undone. (Use Disable if you only want to hide it from students.)",
                        )
                    )
                        return;
                    deleteExercise(id);
                    showToast("Exercise deleted permanently.", "success");
                    render();
                };

                document
                    .getElementById("search-input")
                    .addEventListener("input", debounce(render));
                document
                    .getElementById("filter-subject")
                    .addEventListener("change", render);
                document
                    .getElementById("filter-type")
                    .addEventListener("change", render);
                document
                    .getElementById("filter-difficulty")
                    .addEventListener("change", render);
                document
                    .getElementById("filter-status")
                    .addEventListener("change", render);
                render();
            });
        </script>
    </body>
</html>
</file>

