<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Take Exercise – Kewi Learning</title>
    <link rel="stylesheet" href="../../css/main.css">
</head>
<body>
    <header class="site-header">
        <nav class="navbar">
            <a href="../../index.html" class="navbar-brand">
                <span class="logo-icon" aria-hidden="true">🥝</span>
                <span class="brand-name">Kewi Learning</span>
            </a>
            <div class="navbar-actions">
                <span id="nav-user-display" class="text-sm fw-semibold"></span>
                <a href="#" id="nav-logout-btn" class="btn btn-ghost btn-sm">Logout</a>
                <button class="btn btn-ghost btn-sm" onclick="toggleTheme()">🌓</button>
            </div>
        </nav>
    </header>
    <main class="container" style="padding-top:var(--space-xl);padding-bottom:var(--space-2xl);" id="main-area">
        <div class="loading-overlay"><div class="spinner"></div><p>Loading exercise...</p></div>
    </main>

    <script src="../../js/constants.js"></script>
    <script src="../../data/users.js"></script>
    <script src="../../data/exercises.js"></script>
    <script src="../../data/results.js"></script>
    <script src="../../js/auth.js"></script>
    <script src="../../js/utils.js"></script>
    <script>
        let currentExercise = null;
        let answers = {};

        document.addEventListener("DOMContentLoaded", () => {
            if (!requireAuth(ROLE_STUDENT)) return;
            const user = getCurrentUser();
            const id = getQueryParam("id");
            currentExercise = findExerciseById(id);
            const area = document.getElementById("main-area");

            if (!currentExercise || currentExercise.status !== STATUS_ACTIVE) {
                area.innerHTML = '<div class="alert alert-error">Exercise not found or inactive.</div><a href="exercises.html" class="btn btn-outline">Back</a>';
                return;
            }
            if (hasAttempted(user.id, id)) {
                area.innerHTML = `
                    <div class="alert alert-warning">
                        <div>
                            <strong>Already submitted!</strong>
                            <p class="mb-0">You have already completed this exercise. Only one attempt is allowed.</p>
                        </div>
                    </div>
                    <a href="results.html" class="btn btn-primary">View My Results</a>
                    <a href="exercises.html" class="btn btn-outline">Browse Exercises</a>
                `;
                return;
            }

            renderExercise(area);
        });

        function renderExercise(area) {
            const ex = currentExercise;
            const isReading = ex.type === EXERCISE_TYPE_READING && ex.passage;

            let header = `
                <div class="page-header mb-lg">
                    <a href="exercises.html" class="btn btn-sm btn-ghost mb-sm">← Back</a>
                    <h1 class="page-title">${escapeHtml(ex.title)}</h1>
                    <div class="flex gap-sm flex-wrap">
                        ${getSubjectBadge(ex.subject)}
                        ${getDifficultyBadge(ex.difficulty)}
                        <span class="badge badge-info">${(ex.questions||[]).length} questions</span>
                    </div>
                    ${ex.description ? `<p class="text-muted mt-md">${escapeHtml(ex.description)}</p>` : ""}
                </div>
                <div class="alert alert-info mb-lg">
                    <span>⚠️ You have <strong>one attempt only</strong>. Review carefully before submitting.</span>
                </div>
            `;

            // Quiz nav
            let navHtml = '<div class="quiz-nav" id="quiz-nav">';
            (ex.questions || []).forEach((q, i) => {
                navHtml += `<button type="button" class="quiz-nav-btn" data-index="${i}" onclick="scrollToQ(${i})">${i+1}</button>`;
            });
            navHtml += '</div>';

            let questionsHtml = (ex.questions || []).map((q, i) => {
                let inputHtml = "";
                if (q.type === "multiple_choice" || q.type === "true_false") {
                    const opts = q.options || (q.type === "true_false" ? ["true", "false"] : []);
                    inputHtml = opts.map((opt, oi) => `
                        <label class="form-check">
                            <input type="radio" name="q_${q.id}" value="${escapeHtml(opt)}" onchange="recordAnswer('${q.id}', this.value)">
                            <span>${escapeHtml(opt)}</span>
                        </label>
                    `).join("");
                } else if (q.type === "fill_blank") {
                    inputHtml = `<input type="text" class="form-control" placeholder="Type your answer..." onchange="recordAnswer('${q.id}', this.value)" oninput="recordAnswer('${q.id}', this.value)">`;
                } else {
                    inputHtml = `<input type="text" class="form-control" onchange="recordAnswer('${q.id}', this.value)">`;
                }
                return `
                    <div class="question-card" id="q-block-${i}">
                        <div class="question-number">Question ${i+1}</div>
                        <p class="fw-semibold mb-md">${escapeHtml(q.text)}</p>
                        ${inputHtml}
                    </div>
                `;
            }).join("");

            if (isReading) {
                area.innerHTML = header + navHtml + `
                    <div class="reading-layout">
                        <div class="reading-passage">
                            <h3>📖 Reading Passage</h3>
                            <div style="white-space:pre-wrap;">${escapeHtml(ex.passage)}</div>
                        </div>
                        <div class="reading-questions">
                            ${questionsHtml}
                            <div class="mt-lg">
                                <button class="btn btn-primary btn-lg btn-block" onclick="submitExercise()">Submit Answers</button>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                area.innerHTML = header + navHtml + `
                    <div class="flex-col gap-lg" style="max-width:700px;">
                        ${questionsHtml}
                        <button class="btn btn-primary btn-lg" onclick="submitExercise()">Submit Answers</button>
                    </div>
                `;
            }
        }

        window.recordAnswer = function(qid, value) {
            answers[qid] = value;
            // Update nav
            const questions = currentExercise.questions || [];
            const idx = questions.findIndex(q => q.id === qid);
            if (idx >= 0) {
                const btn = document.querySelector(`.quiz-nav-btn[data-index="${idx}"]`);
                if (btn) btn.classList.add("answered");
            }
        };

        window.scrollToQ = function(i) {
            const el = document.getElementById("q-block-" + i);
            if (el) el.scrollIntoView({ behavior: "smooth", block: "center" });
            document.querySelectorAll(".quiz-nav-btn").forEach(b => b.classList.remove("current"));
            const btn = document.querySelector(`.quiz-nav-btn[data-index="${i}"]`);
            if (btn) btn.classList.add("current");
        };

        window.submitExercise = function() {
            const user = getCurrentUser();
            const questions = currentExercise.questions || [];
            const unanswered = questions.filter(q => !answers[q.id] || answers[q.id].toString().trim() === "");
            if (unanswered.length > 0) {
                if (!confirmAction(`You have ${unanswered.length} unanswered question(s). Submit anyway?`)) return;
            }
            if (!confirmAction("Submit your answers? You cannot change them afterwards.")) return;

            try {
                const result = submitResult(user.id, currentExercise.id, answers);
                showToast("Submitted! Score: " + result.percentage + "%", "success");
                setTimeout(() => {
                    window.location.href = "result-detail.html?id=" + result.id;
                }, 1000);
            } catch (err) {
                showToast(err.message || "Submission failed.", "error");
            }
        };
    </script>
</body>
</html>
</file>

