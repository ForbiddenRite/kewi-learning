                    <p class="page-subtitle">Manage student accounts</p>
                </div>
                <a href="create-student.html" class="btn btn-primary">➕ Add Student</a>
            </div>

            <div class="table-wrapper">
                <table class="table" id="students-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Class</th>
                            <th>Email</th>
                            <th>Completed</th>
                            <th>Avg Score</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="students-body"></tbody>
                </table>
            </div>
