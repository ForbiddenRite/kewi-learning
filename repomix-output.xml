    <!-- Edit Modal -->
    <div class="modal-overlay" id="edit-modal">
        <div class="modal">
            <div class="modal-header">
                <h3>Edit Student</h3>
                <button class="modal-close" onclick="closeEditModal()">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-id">
                <div class="form-group">
                    <label class="form-label">Full Name</label>
                    <input type="text" id="edit-fullname" class="form-control">
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" id="edit-email" class="form-control">
                </div>
                <div class="form-group">
                    <label class="form-label">Class</label>
                    <input type="text" id="edit-class" class="form-control">
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select id="edit-status" class="form-control">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-ghost" onclick="closeEditModal()">Cancel</button>
                <button class="btn btn-primary" onclick="saveEdit()">Save</button>
            </div>
        </div>
    </div>

    <script src="../../js/constants.js"></script>
    <script src="../../data/users.js"></script>
    <script src="../../data/exercises.js"></script>
    <script src="../../data/results.js"></script>
    <script src="../../js/auth.js"></script>
    <script src="../../js/utils.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (!requireAuth(ROLE_TEACHER)) return;
            renderStudents();
        });

        function renderStudents() {
            const students = getStudents();
            const tbody = document.getElementById("students-body");
            if (students.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">No students yet.</td></tr>';
                return;
            }
            tbody.innerHTML = students.map(s => {
                const results = getResultsByStudent(s.id);
                const avg = results.length
                    ? Math.round(results.reduce((a, r) => a + r.percentage, 0) / results.length)
                    : 0;
                return `
                    <tr>
                        <td class="fw-semibold">${escapeHtml(s.fullName)}</td>
                        <td>${escapeHtml(s.username)}</td>
                        <td>${escapeHtml(s.className || "—")}</td>
                        <td>${escapeHtml(s.email || "—")}</td>
                        <td>${results.length}</td>
                        <td>${results.length ? getScoreBadge(avg) : "—"}</td>
                        <td><span class="badge ${s.status === 'active' ? 'badge-success' : 'badge-error'}">${s.status}</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline" onclick="openEdit('${s.id}')">Edit</button>
                            <button class="btn btn-sm btn-danger" onclick="handleDelete('${s.id}')">Delete</button>
                        </td>
                    </tr>
                `;
            }).join("");
        }

        window.openEdit = function(id) {
            const s = findUserById(id);
            if (!s) return;
            document.getElementById("edit-id").value = s.id;
            document.getElementById("edit-fullname").value = s.fullName || "";
            document.getElementById("edit-email").value = s.email || "";
            document.getElementById("edit-class").value = s.className || "";
            document.getElementById("edit-status").value = s.status || "active";
            document.getElementById("edit-modal").classList.add("active");
        };

        window.closeEditModal = function() {
            document.getElementById("edit-modal").classList.remove("active");
        };

        window.saveEdit = function() {
            const id = document.getElementById("edit-id").value;
            try {
                updateUser(id, {
                    fullName: document.getElementById("edit-fullname").value.trim(),
                    email: document.getElementById("edit-email").value.trim(),
                    className: document.getElementById("edit-class").value.trim(),
                    status: document.getElementById("edit-status").value
                });
                showToast("Student updated.", "success");
                closeEditModal();
                renderStudents();
            } catch (err) {
                showToast(err.message, "error");
            }
        };

        window.handleDelete = function(id) {
            if (!confirmAction("Permanently delete this student account?")) return;
            deleteUser(id);
            showToast("Student deleted.", "success");
            renderStudents();
        };
    </script>
</body>
</html>
