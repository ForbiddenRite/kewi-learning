    <script src="../../data/results.js"></script>
    <script src="../../js/auth.js"></script>
    <script src="../../js/utils.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (!requireAuth(ROLE_STUDENT)) return;
            const currentUser = getCurrentUser();

            // Overall
            const overall = getOverallLeaderboard();
            document.getElementById("overall-body").innerHTML = overall.map(item => {
                const s = findUserById(item.studentId);
                const isMe = item.studentId === currentUser.id;
                return `<tr style="${isMe ? 'background:var(--color-accent);' : ''}">
                    <td><strong>#${item.rank}</strong></td>
                    <td>${escapeHtml(s ? s.fullName : "Unknown")}${isMe ? ' <span class="badge badge-primary">You</span>' : ''}</td>
                    <td>${getScoreBadge(item.avgPercentage)}</td>
                    <td>${item.completedCount}</td>
                    <td>${item.totalScore}</td>
                </tr>`;
            }).join("") || '<tr><td colspan="5" class="text-center text-muted">No data yet.</td></tr>';

            // By exercise
            const exercises = getActiveExercises();
            const select = document.getElementById("ex-select");
            exercises.forEach(ex => {
                select.innerHTML += `<option value="${ex.id}">${escapeHtml(ex.title)}</option>`;
            });

            function loadExBoard() {
                const exId = select.value;
                if (!exId) return;
                const board = getExerciseLeaderboard(exId);
                document.getElementById("ex-body").innerHTML = board.map(item => {
                    const s = findUserById(item.studentId);
                    const isMe = item.studentId === currentUser.id;
                    return `<tr style="${isMe ? 'background:var(--color-accent);' : ''}">
                        <td><strong>#${item.rank}</strong></td>
                        <td>${escapeHtml(s ? s.fullName : "Unknown")}${isMe ? ' <span class="badge badge-primary">You</span>' : ''}</td>
                        <td>${item.score}/${item.maxScore}</td>
                        <td>${getScoreBadge(item.percentage)}</td>
                        <td>${formatDate(item.submittedAt)}</td>
                    </tr>`;
                }).join("") || '<tr><td colspan="5" class="text-center text-muted">No submissions for this exercise.</td></tr>';
            }
            select.addEventListener("change", loadExBoard);
            if (exercises.length) loadExBoard();
        });
    </script>
</body>
</html>
